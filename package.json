{
  "name": "web3-homework-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "Web3精英班课后作业小助手 - 基于Cloudflare Workers的RAG系统",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc && node build.js",
    "type-check": "tsc --noEmit",
    "local-import": "node scripts/local-import.mjs",
    "download-r2": "node scripts/download-from-r2.mjs"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.450.0",
    "@cloudflare/workers-types": "^4.20231218.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.3",
    "wrangler": "^3.22.0"
  }
}
